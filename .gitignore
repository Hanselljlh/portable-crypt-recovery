# Python
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
*.egg-info/
build/
dist/

# Virtual environments
.venv/
venv/

# Local app data
PCR/workspaces/
PCR/logs/
portable-workspaces/

# Dev-mode runtime folders created by ensure_default_portable_layout()
# when running `python -m portable_crypt_recovery` from the repo root.
# The folders are tracked via .gitkeep; their contents are ignored.
tools/hashcat/*
!tools/hashcat/.gitkeep
tools/hashcat/hashcat
tools/hashcat/hashcat.exe
workspaces/default/*
!workspaces/default/.gitkeep
app/*
!app/.gitkeep
config/*
!config/.gitkeep
logs/*
!logs/.gitkeep

# OS/editor
.DS_Store
Thumbs.db
.idea/
.vscode/
